// Shadow of Salem — R2 Upload Worker
// Deploy: cd r2-worker && npx wrangler deploy
//
// BEFORE DEPLOYING — set these secrets via wrangler CLI:
//   npx wrangler secret put FIREBASE_PROJECT_ID
//   npx wrangler secret put R2_ACCOUNT_ID
//   npx wrangler secret put R2_ACCESS_KEY_ID
//   npx wrangler secret put R2_SECRET_ACCESS_KEY
//   npx wrangler secret put ALLOWED_ORIGIN
//   npx wrangler secret put MEDIA_BUCKET_NAME
//
// ALLOWED_ORIGIN — your Shadow of Salem production domain, e.g.:
//   https://shadowofsalem.pages.dev
//   or https://www.shadowofsalem.com
//
// MEDIA_BUCKET_NAME — the name of your R2 bucket, e.g.:
//   shadow-of-salem-media
//
// R2_ACCOUNT_ID  — find in Cloudflare dashboard → R2 → Overview
// R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY — create in:
//   Cloudflare dashboard → R2 → Manage R2 API tokens → Create API token
//   (give Object Read & Write on your bucket)
//
// FIREBASE_PROJECT_ID — from firebase.js, e.g.: legend-4af26
//
// For local dev, create r2-worker/.dev.vars (never commit it):
//   FIREBASE_PROJECT_ID=legend-4af26
//   R2_ACCOUNT_ID=f276c4406b82d3c1e35efed1ef486235
//   R2_ACCESS_KEY_ID=<your-key-id>
//   R2_SECRET_ACCESS_KEY=<your-secret>
//   ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
//   MEDIA_BUCKET_NAME=shadow-of-salem-media

{
  "name": "shadow-of-salem-r2",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "shadow-of-salem-media",
      "preview_bucket_name": "shadow-of-salem-media-dev"
    }
  ]
}
